    "validate_native.py": {
      "sha256": "01a8175befdfc912d8b80c62c473928c902cc0ec20920579889d29c2f6d69916",
      "source": "import json\nimport runpy\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom time import perf_counter\nfrom twoptimizer.catalog import choices\nfrom twoptimizer.provenance import source_files\nfrom twoptimizer.requests import default_config\nfrom twoptimizer.service import solve_case\n\nhelper=runpy.run_path('/tmp/twoptimizer-native-products-driver/native_product_benchmark.py')\nhelper['install_selector']('three_kingdoms')\nreference=json.loads(Path('/workspace/twoptimizer/reports/three-kingdoms-city-levels.json').read_text())\nexpected={row['id']:next(s['income'] for s in row['samples'] if s['mode']=='auto' and s['algorithm']=='cp-sat') for row in reference['cases']}\noutput={'source_files':source_files('three_kingdoms'),'cases':[]}\nstarted=perf_counter()\nfor _,province in choices('three_kingdoms')['provinces']:\n    result=solve_case(replace(default_config('three_kingdoms'),province=province,seconds=10,workers=4))\n    row={'province':province,'status':result.solver.status,'income':result.income,'expected':expected[province],'model_stats':result.solver.details.get('model_stats'),'seconds':result.solver.seconds}\n    output['cases'].append(row)\n    assert result.solver.status == 'OPTIMAL', row\n    assert abs(result.income-expected[province])<1e-5, row\noutput['wall_seconds']=perf_counter()-started\nPath('/tmp/twoptimizer-native-products-validation.json').write_text(json.dumps(output,indent=2))\nprint('All70 native Three Kingdoms independent optima match reference',output['wall_seconds'],flush=True)\n"
    },
    "validate_final.py": {
      "sha256": "4d45f6f8b03a73bfbf9ce49075b18f53ef8940de3213f15fe52e5ee62d42fcf7",
      "source": "import asyncio,json,runpy\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom twoptimizer.progress import SearchStats\nfrom twoptimizer.provenance import source_files\nfrom twoptimizer.requests import default_config\nfrom twoptimizer.runner import BatchRunner\nfrom twoptimizer.service import solve_case\nhelper=runpy.run_path('/tmp/twoptimizer-native-products-driver/supplemental_benchmark.py')\nreport={'source_files':{g:source_files(g) for g in ('attila','rome2','shogun2','three_kingdoms')}}\n\ndef config(game, seconds):\n    return replace(default_config(game),provinces=helper['scope_holdings'](game,'eight'),joint=True,seconds=seconds,workers=4)\n\nasync def main():\n    runner=BatchRunner()\n    stop_task=None\n    try:\n        attila=await runner.run(config('attila',15),lambda _:None)\n        assert attila is not None, 'Attila worker did not return'\n        assert attila['solver']['model_stats']['product_encoding']=='native', attila['solver']\n        assert attila['solver']['status'] in ('FEASIBLE','OPTIMAL'), attila['solver']\n        report['attila_auto']={'status':attila['solver']['status'],'income':attila['income'],'model_stats':attila['solver']['model_stats']}\n        print('Installed Attila eight-province request selects native products and validates a layout',flush=True)\n        def observe(event):\n            nonlocal stop_task\n            if isinstance(event,SearchStats) and event.objective is not None and stop_task is None:\n                stop_task=asyncio.create_task(runner.request_stop())\n        first=await runner.run(config('three_kingdoms',30),lambda _:None,observe)\n        assert first is not None and first['income'] is not None, first\n        assert first['raw']['cancellation']['incumbent_retained']\n        assert first['solver']['model_stats']['formulation']=='native_products'\n        process=runner.process\n        runner.begin_batch()\n        second=await runner.run(config('three_kingdoms',0.01),lambda _:None)\n        assert second is not None and second['income']>=first['income']-1e-5\n        assert second['raw']['solver']['seed_reused']\n        assert runner.process is process\n        report['three_kingdoms_auto_cancel_repeat']={'first_status':first['solver']['status'],'first_income':first['income'],'second_status':second['solver']['status'],'second_income':second['income'],'same_worker':True,'seed_reused':True,'model_stats':first['solver']['model_stats']}\n        print('Installed Three Kingdoms auto-native Cancel/Run retains validated layout and worker',flush=True)\n    finally:\n        await runner.stop()\n        if stop_task is not None: await stop_task\n    for game in ('rome2','shogun2','three_kingdoms'):\n        result=solve_case(replace(default_config(game),seconds=5,workers=1))\n        stats=result.solver.details.get('model_stats',result.solver.details)\n        report[game+'_single']={'status':result.solver.status,'income':result.income,'formulation':stats.get('formulation')}\n        assert 'native' not in stats.get('formulation','')\n    highs=solve_case(replace(default_config('three_kingdoms'),algorithm='highs',seconds=5,workers=1))\n    assert highs.solver.status=='OPTIMAL' and highs.income==627.75\n    report['highs']={'status':highs.solver.status,'income':highs.income}\n    Path('/tmp/twoptimizer-native-products-final-validation.json').write_text(json.dumps(report,indent=2))\n    print('Final installed validation complete',flush=True)\n\nasyncio.run(main())\n"
    },
    "rome_pricing_identity.py": {
      "sha256": "7fbf5f4e9c090fc3c1b9c3e45d306786dea0f836d313f21f96e42adabd6ce78a",
      "source": "import hashlib,json,runpy,sys\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom twoptimizer.requests import default_config\nfrom twoptimizer.service import solve_case\nfrom games.tw.rome2 import bound_search\nvariant=sys.argv[1]\nhelper=runpy.run_path('/tmp/twoptimizer-native-products-driver/native_product_benchmark.py')\nif variant=='native': helper['install_selector']('rome2')\nclass Captured(Exception): pass\ndef capture(proto, food_row, *args, **kwargs):\n    raw=proto.SerializeToString(deterministic=True)\n    report={'variant':variant,'sha256':hashlib.sha256(raw).hexdigest(),'variables':len(proto.variable),'constraints':len(proto.constraint),'food_row':food_row,'price_allowance_seconds':args[0] if args else kwargs.get('seconds')}\n    Path('/tmp/twoptimizer-native-products-rome-pricing-'+variant+'.json').write_text(json.dumps(report,indent=2))\n    print(report,flush=True)\n    raise Captured\nbound_search.estimate_lower_bound_price=capture\ntry:\n    solve_case(replace(default_config('rome2'),provinces=('all',),joint=True,seconds=60,workers=4))\nexcept Captured: pass\nelse: raise AssertionError('Pricing capture not reached')\n"
    }
