    {
      "id": "production.powered_output",
      "status": "documented_observation",
      "observation": "Coal-era daily base output differs between unpowered and powered factories.",
      "source_ids": [
        "wiki.production",
        "raw.defines"
      ],
      "target_patch_validation": "pending",
      "values": {
        "civilian_unpowered": 4,
        "civilian_powered": 5,
        "military_unpowered": 3.5,
        "military_powered": 4.5,
        "dockyard_unpowered": 2,
        "dockyard_powered": 2.5
      },
      "caveat": "These endpoints do not establish the exact partial-energy allocation formula."
    },
    {
      "id": "consumer_goods.factor",
      "status": "documented_observation",
      "observation": "Expected consumer goods is the sum of base modifiers multiplied by the product of each (1 + factor). Apply the minimum percentage and round the resulting factory count down.",
      "source_ids": [
        "steam.consumer_goods_2023",
        "wiki.construction",
        "raw.defines"
      ],
      "target_patch_validation": "pending",
      "formula": "floor(max(sum(base_modifiers) * product(1 + factor), minimum_fraction) * total_factories)",
      "caveat": "Raw constants additionally name an absolute minimum of 1 and minimum fraction 0.10. Their full interaction and the factory accounting boundary require validation."
    },
    {
      "id": "production.efficiency",
      "status": "documented_observation",
      "observation": "Documented base efficiency starts at 0.10, with a 0.50 base cap; daily gain is nonlinear. Efficiency is tracked per factory slot.",
      "source_ids": [
        "wiki.production",
        "raw.defines",
        "steam.efficiency_2017",
        "raw.production_localization"
      ],
      "target_patch_validation": "pending",
      "formula": "daily_base_gain = 0.001 * efficiency_cap ** 2 / current_efficiency",
      "caveat": "Publisher notes establish nonlinear growth and UI labels give a daily rate, but neither establishes the hourly recurrence or event cadence. The same localization file contains an apparently stale per-unit gain description at line43, so UI strings alone are not executable semantics.",
      "source_locators": [
        {
          "source_id": "raw.production_localization",
          "line": 42,
          "key": "PRODUCTION_EFFICIENCY_WITH_GAIN"
        },
        {
          "source_id": "raw.production_localization",
          "line": 178,
          "key": "PRODUCTION_EFFICIENCY_GAIN_BASE"
        }
      ]
    },
    {
      "id": "production.switch_retention",
      "status": "documented_observation",
      "observation": "Switch retention depends on the relationship between old and new equipment, with an initial-efficiency floor.",
      "source_ids": [
        "wiki.production",
        "raw.defines"
      ],
      "target_patch_validation": "pending",
      "values": {
        "variant": 0.9,
        "family": 0.7,
        "parent_child": 0.3,
        "archetype": 0.2,
        "other": 0.1
      },
      "formula": "max(start_efficiency, previous_efficiency * (retention + (1 - retention) * retention_bonus))",
      "caveat": "The wiki describes a fixed variant-change loss exception. Equipment relationships and DLC designer rules must be resolved before implementation."
    },
    {
      "id": "resources.flow",
      "status": "documented_observation",
      "observation": "Strategic resources are flows, not inventories. Fuel has its own inventory. Production priority and cumulative resource deficits affect each factory; documented shortage is 5% per missing resource unit, capped at 100%, using the worst resource deficit.",
      "source_ids": [
        "wiki.production",
        "raw.defines"
      ],
      "target_patch_validation": "pending",
      "caveat": "Exact engine allocation order and rounding remain unverified."
    },
    {
      "id": "resources.trade",
      "status": "documented_observation",
      "observation": "A normal trade spends one civilian factory for up to eight resource units; a partial block still costs one factory. Subject rates and availability differ.",
      "source_ids": [
        "wiki.trade"
      ],
      "target_patch_validation": "pending"
    },
    {
      "id": "training.capacity",
      "status": "documented_observation",
      "observation": "Concurrent training manpower has a documented base cap of max(100000, 0.75 * fielded_manpower).",
      "source_ids": [
        "wiki.army_planner",
        "raw.defines"
      ],
      "target_patch_validation": "pending"
    },
    {
      "id": "training.duration",
      "status": "documented_observation",
      "observation": "Template equipment and manpower requirements sum over battalions and companies. Base training time is the maximum constituent training time, with applicable modifiers.",
      "source_ids": [
        "wiki.land_units"
      ],
      "target_patch_validation": "pending"
    },
    {
      "id": "training.progress",
      "status": "documented_observation",
      "observation": "Recruitment training can overlap equipment delivery and is capped by equipment availability. The mirrored game UI describes its maximum deployment experience as dependent on equipment; the AI define comment also describes an equipment-deficit cap.",
      "source_ids": [
        "wiki.army_planner",
        "raw.deployment_localization",
        "raw.defines"
      ],
      "target_patch_validation": "pending",
      "caveat": "These sources do not establish the equipment weighting, manpower gate, progress update cadence, or exact delivery timing. AI deployment thresholds are policy, not the player training formula.",
      "source_locators": [
        {
          "source_id": "raw.deployment_localization",
          "line": 17,
          "key": "DEPLOYMENT_TRAINING_MAXVALUE_DESC"
        },
        {
          "source_id": "raw.deployment_localization",
          "line": 21,
          "key": "DEPLOYMENT_EXPERIENCE_ESTIMATED_DESC"
        },
        {
          "source_id": "raw.defines",
          "line": 2422,
          "key": "NAI.DEPLOY_MIN_EQUIPMENT_CAP_DEPLOY_FACTOR"
        }
      ]
    },
    {
      "id": "training.level",
      "status": "documented_observation",
      "observation": "The cited base rules produce Trained on completion of recruitment training. Field exercises can reach Regular and consume equipment; applicable experience modifiers still need mapping.",
      "source_ids": [
        "wiki.army_planner",
        "raw.defines"
      ],
      "target_patch_validation": "pending"
    },
    {
      "id": "manpower.mobilization",
      "status": "documented_observation",
      "observation": "Free manpower differs from potential recruitable population. Mobilization over time matters after conscription changes.",
      "source_ids": [
        "wiki.recruitable_population",
        "wiki.manpower"
      ],
      "target_patch_validation": "pending"
    },
    {
      "id": "energy.partial_output",
      "source_ids": [
        "steam.energy.1803527891506227",
        "steam.energy.1816849002007641"
      ],
      "status": "publisher_documented_design_confirmed_in_launch_eve_diary",
      "observation": "Energy fulfillment interpolates between unpowered and fully powered base factory output. The developer explicitly gives 50% fulfillment as halfway.",
      "inference": "base_output = unpowered + fulfillment * (powered - unpowered)",
      "target_patch_validation": "pending"
    },
    {
      "id": "energy.positive_bonus_scaling",
      "source_ids": [
        "steam.energy.1816849002007641"
      ],
      "status": "publisher_documented_launch_eve_rule",
      "observation": "Energy shortage scales the sum of factory-output, construction-speed or dockyard-output modifiers only when the relevant sum is positive. Nonpositive summed bonuses avoid this additional scaling.",
      "inference": "bonus = summed_bonus if summed_bonus <= 0 else fulfillment * summed_bonus",
      "target_patch_validation": "pending"
    },
    {
      "id": "energy.demand_structure",
      "source_ids": [
        "steam.energy.1803527891506227"
      ],
      "status": "publisher_documented_design",
      "observation": "Civilian, military and naval factories share base energy demand; each additional factory also increases demand per factory. Economic-law energy modifiers affect both base and scaled parts.",
      "remaining_unknown": "Exact accounting of trade/occupation/damage and composition of national/local modifiers.",
      "target_patch_validation": "pending"
    },
    {
      "id": "energy.zero_demand_and_cap",
