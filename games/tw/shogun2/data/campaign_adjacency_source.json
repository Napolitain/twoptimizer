    "parser_sources": [
      "https://github.com/Psychocrysma/Total-War-Shogun-2-Fixing-and-Convenience-project/blob/c0e72325aacb6614ccba2c936c838c020fa54651/tools/esf.py",
      "https://github.com/Psychocrysma/Total-War-Shogun-2-Fixing-and-Convenience-project/blob/c0e72325aacb6614ccba2c936c838c020fa54651/tools/pfh.py",
