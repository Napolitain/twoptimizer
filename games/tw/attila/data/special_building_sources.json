  "claims": [
    {
      "id": "capital_requirement_exists",
      "sources": [
        "capital_mod_ionized",
        "capital_mod_bladeuk"
      ],
      "finding": "Certain legendary or tier-five buildings require the faction capital, rather than any province capital. Authors describe removing that restriction; the descriptions do not enumerate exact vanilla building IDs.",
      "per_building_flags_verified": false
    },
    {
      "id": "capital_is_not_uniqueness",
      "sources": [
        "attila_schema"
      ],
      "finding": "building_levels defines separate only_in_capital and faction_unique boolean columns and a first_in_world_bundle reference. Their existence does not supply per-building values or prove their runtime semantics.",
      "per_building_flags_verified": false
    },
    {
      "id": "dam_state",
      "sources": [
        "official_empires_sand",
        "honga_dam"
      ],
      "building": "att_bld_eos_marib_dam",
      "finding": "Himyar has a unique fertility-improving dam at its capital. Recurring repairs cost money; neglect can cause flooding. Its displayed effects do not define repair probabilities, event costs, upkeep or ownership/conquest rules."
    },
    {
      "id": "slavic_metadata_incomplete",
      "sources": [
        "official_slavic",
        "capital_mod_ionized"
      ],
      "finding": "Slavic wonders exist, affect province and faction, and have maintenance costs. The legendary-capital mod was updated for Slavic wonders in February 2016. No raw restrictions or upkeep values were recovered."
    }
  ],
